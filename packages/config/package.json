{
  "name": "@neamat/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and PostCSS config for the Neamat Global monorepo",
  "type": "module",
  "bin": {
    "neamat-tsc": "./bin/neamat-tsc.mjs"
  },
  "exports": {
    "./typescript/base.json": "./typescript/base.json",
    "./typescript/nextjs.json": "./typescript/nextjs.json",
    "./typescript/react-library.json": "./typescript/react-library.json",
    "./eslint/base": "./eslint/base.mjs",
    "./eslint/next": "./eslint/next.mjs",
    "./eslint/theme-lock": "./eslint/theme-lock.mjs",
    "./postcss": "./postcss/postcss.config.mjs"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "eslint-config-next": "*"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    }
  }
}
