{
  "name": "@neamat/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Neamat Global shared design system — shadcn primitives, brand components and design tokens",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/brand/*": "./src/components/brand/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./motion/*": "./src/motion/*.ts"
  },
  "scripts": {
    "ui:add": "shadcn add --yes",
    "lint": "eslint .",
    "typecheck": "neamat-tsc --noEmit"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^13.4.6",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@neamat/config": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.3.7",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
